STT_URL=http://localhost:9000/transcribe
STT_API_KEY=
STT_API_HEADER_NAME=Authorization
# If your STT expects JSON with base64 audio set STT_SEND_JSON=true
# Otherwise the backend will send multipart/form-data with field name STT_FILE_FIELD
STT_SEND_JSON=false
STT_FILE_FIELD=file
ANALYSIS_URL=http://localhost:9001/analyze
ANALYSIS_API_KEY=
QUESTIONS_URL=http://localhost:9002/questions
QUESTIONS_API_KEY=

# Notes:
# - The STT stub expects a multipart/form-data 'file' field and returns JSON {"text":...}
# - If your STT service requires an API key, set STT_API_KEY; the backend will send it as Bearer token.
# - Ensure ffmpeg is installed on the machine for automatic webm->wav conversion.